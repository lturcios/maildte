NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://maildte:secret@postgres:5432/maildte
REDIS_URL=redis://redis:6379
ENCRYPTION_KEY=            # 32 bytes hex (openssl rand -hex 32)
API_KEY=                   # openssl rand -hex 24
STORAGE_ROOT=/data/storage
DEFAULT_SYNC_INTERVAL=300
TZ_FOLDER=America/El_Salvador
LOG_LEVEL=info
MAX_ATTACHMENT_MB=25
# --- Libro de compras (Addendum 10) ---
# Tope de filas del export del Anexo 3 (CSV/XLSX). El XLSX se construye en memoria.
PURCHASE_BOOK_EXPORT_MAX_ROWS=20000
# Tamano maximo de lote de POST /purchase-book/reprocess (1-5000).
PURCHASE_BOOK_REPROCESS_BATCH=1000
# Cap de tamano del JSON de un DTE antes de leerlo y parsearlo (bytes). 2 MiB.
DTE_MAX_JSON_BYTES=2097152
# Concurrencia del worker de la cola "dte" (1-16). Comparte pool de Prisma con el sync.
DTE_QUEUE_CONCURRENCY=4
