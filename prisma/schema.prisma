generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVA
  INACTIVA
  ERROR_AUTH
}

enum TenantStatus {
  ACTIVO
  SUSPENDIDO
}

enum Role {
  SUPERADMIN
  ADMIN
  MIEMBRO
}

enum EmailStatus {
  PROCESADO
  SIN_ADJUNTOS
  ERROR
}

enum AttachmentType {
  JSON
  PDF
}

enum SyncStatus {
  EJECUTANDO
  COMPLETADO
  COMPLETADO_CON_ERRORES
  ERROR
}

enum DomainMatchKind {
  DOMAIN // dominio del correo: gmail.com
  MX_SUFFIX // sufijo del registro MX: google.com
}

// Resultado del parseo de un adjunto JSON de DTE (Addendum 10, ADR-10.1).
enum DteParseStatus {
  PARSEADO
  DUPLICADO // mismo [tenantId, codigoGeneracion] ya ingresado desde otro adjunto
  IGNORADO_TIPO // DTE válido con tipoDte != "03"
  VERSION_NO_SOPORTADA // identificacion.version fuera de {3, 4}
  NO_ES_DTE // JSON válido que no es un sobre DTE
  JSON_INVALIDO
  ARCHIVO_DEMASIADO_GRANDE
  ARCHIVO_FALTANTE
  ERROR // campos faltantes o inválidos; errorDetail los enumera
}

model Tenant {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique // [a-z0-9-], inmutable tras la creación
  status          TenantStatus @default(ACTIVO)
  maxAccounts     Int          @default(3)
  maxStorageBytes BigInt       @default(5368709120) // 5 GB
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users       User[]
  apiKeys     TenantApiKey[]
  accounts    EmailAccount[]
  emails      ProcessedEmail[]
  attachments Attachment[]
  syncLogs    SyncLog[]

  // Addendum 10 — Libro de compras
  dteParties        DteParty[]
  dteParseResults   DteParseResult[]
  purchaseDocuments PurchaseDocument[]

  // Addendum 11 — fase 3: segmentación por actividad
  purchaseActivities       PurchaseActivity[]
  supplierActivityDefaults SupplierActivityDefault[]

  @@map("tenants")
}

model User {
  id                      String    @id @default(uuid())
  tenantId                String? // null solo para SUPERADMIN
  tenant                  Tenant?   @relation(fields: [tenantId], references: [id])
  email                   String    @unique
  name                    String
  passwordHash            String // argon2id
  role                    Role      @default(MIEMBRO)
  active                  Boolean   @default(true)
  lastLoginAt             DateTime?
  // Estado mínimo necesario para rotación de refresh token y logout: hash del jti
  // del refresh token vigente. Sesión única por usuario a propósito (MVP); un login
  // o refresh nuevo sobrescribe este valor e invalida cualquier refresh token previo.
  currentRefreshTokenHash String?
  createdAt               DateTime  @default(now())

  @@index([tenantId])
  @@map("users")
}

model TenantApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String // "CLI oficina", "n8n"
  keyHash    String    @unique // sha256 de la key; la key en claro solo se muestra al crear
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@map("tenant_api_keys")
}

/// Catálogo maestro global de servicios de correo (Addendum 09). Sin tenantId:
/// es público a todos los tenants y solo SUPERADMIN lo escribe. Deliberadamente
/// SIN RLS — ver el comentario de la migración mail_providers.
model MailProvider {
  id             String  @id @default(uuid())
  key            String  @unique // "gmail", "microsoft365"
  name           String // "Gmail / Google Workspace"
  imapHost       String
  imapPort       Int     @default(993)
  imapSecure     Boolean @default(true)
  defaultMailbox String  @default("INBOX")
  /// Dominio obvio (gmail.com, outlook.com): advertir si el usuario cambia el
  /// perfil detectado automáticamente por otro (ADR-09.1).
  strict         Boolean @default(false)
  /// Requisitos de autenticación en lenguaje del usuario ("necesitás una
  /// contraseña de aplicación"). Es lo que evita la mayoría de los tickets.
  notes          String?
  helpUrl        String?
  /// false = oculto del desplegable de alta. NO desvincula cuentas existentes:
  /// es el mecanismo de retiro de un perfil, en vez del DELETE (ADR-09.1).
  active         Boolean @default(true)
  sortOrder      Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains  MailProviderDomain[]
  accounts EmailAccount[]

  @@map("mail_providers")
}

/// Dominios que resuelven a un perfil, por coincidencia exacta del dominio del
/// correo (DOMAIN) o por sufijo del registro MX (MX_SUFFIX, ADR-09.3).
model MailProviderDomain {
  id         String          @id @default(uuid())
  providerId String
  provider   MailProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  domain     String
  kind       DomainMatchKind @default(DOMAIN)
  createdAt  DateTime        @default(now())

  // La unicidad es por (kind, domain), no por domain solo: "outlook.com" existe
  // como dominio de correo personal Y como sufijo MX de Microsoft 365.
  @@unique([kind, domain])
  @@index([providerId])
  @@map("mail_provider_domains")
}

model EmailAccount {
  id         String @id @default(uuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  alias      String // "Compras Casa Matriz"
  email      String // compras@ltsoft.us
  folderName String // compras_ltsoft_us (normalizado)

  /// ADR-09.1/09.2 — referencia viva: con providerId, el endpoint efectivo sale
  /// del perfil en cada sync (un cambio del SUPERADMIN aplica en la siguiente
  /// ronda). Con providerId NULL, mandan las tres columnas imap* de abajo:
  /// ese es el camino "servidor personalizado". Resolución en un solo lugar:
  /// src/sync/imap/resolve-imap-endpoint.ts
  providerId String?
  provider   MailProvider? @relation(fields: [providerId], references: [id], onDelete: Restrict)

  imapHost     String
  imapPort     Int           @default(993)
  imapSecure   Boolean       @default(true)
  imapUser     String
  imapPassEnc  String // AES-256-GCM (iv:tag:cipher, base64)
  mailbox      String        @default("INBOX")
  syncInterval Int           @default(300) // segundos
  syncFromDate DateTime      @default(now())
  lastUid      Int           @default(0)
  uidValidity  BigInt? // detección de reset del buzón
  lastSyncAt   DateTime?
  lastError    String?
  status       AccountStatus @default(ACTIVA)
  deletedAt    DateTime? // soft delete
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  emails   ProcessedEmail[]
  syncLogs SyncLog[]

  @@unique([tenantId, email])
  @@unique([tenantId, folderName])
  @@index([tenantId])
  @@index([providerId])
  @@map("email_accounts")
}

model ProcessedEmail {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  accountId       String
  account         EmailAccount @relation(fields: [accountId], references: [id])
  messageId       String // header Message-ID
  uid             Int // UID IMAP
  subject         String       @default("")
  senderName      String       @default("")
  senderEmail     String
  recipients      String[] // direcciones To
  receivedAt      DateTime // header Date (UTC)
  processedAt     DateTime     @default(now())
  monthFolder     String // "2026-08" (TZ El Salvador)
  attachmentCount Int          @default(0)
  status          EmailStatus
  errorDetail     String?

  attachments Attachment[]

  @@unique([accountId, messageId]) // idempotencia — accountId ya es único global, no se toca
  @@index([accountId, receivedAt])
  @@index([tenantId, receivedAt])
  @@index([senderEmail])
  @@index([status])
  @@map("processed_emails")
}

model Attachment {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  emailId      String
  email        ProcessedEmail @relation(fields: [emailId], references: [id])
  originalName String
  storedName   String
  relativePath String // compras_ltsoft_us/2026-08/json/x.json
  fileType     AttachmentType
  mimeType     String
  sizeBytes    Int
  sha256       String
  createdAt    DateTime       @default(now())

  // Addendum 10 — Libro de compras. Solo aplican a fileType = JSON.
  parseResult      DteParseResult?
  purchaseDocument PurchaseDocument?

  @@index([emailId])
  @@index([sha256])
  @@index([tenantId, createdAt, id])
  @@map("attachments")
}

model SyncLog {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  accountId       String
  account         EmailAccount @relation(fields: [accountId], references: [id])
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  emailsFound     Int          @default(0)
  emailsProcessed Int          @default(0)
  emailsSkipped   Int          @default(0) // duplicados
  filesDownloaded Int          @default(0)
  status          SyncStatus   @default(EJECUTANDO)
  errorDetail     String?
  trigger         String       @default("scheduler") // scheduler | manual

  @@index([accountId, startedAt])
  @@index([tenantId, startedAt])
  @@map("sync_logs")
}

// =============================================================
// Addendum 10 — Libro de compras
//
// Parseo de adjuntos JSON de DTE tipoDte "03" (Comprobante de Crédito Fiscal),
// esquemas de Hacienda v3 y v4, hacia tablas normalizadas que alimentan el
// Anexo 3 "Detalle de Compras".
//
// Las 6 tablas llevan tenantId y RLS FORCE + policy tenant_isolation, escritas
// a mano en la migración (Prisma no las genera).
// =============================================================

/// Catálogo por tenant de emisores/receptores vistos en DTE (ADR-10.2).
/// Alimenta los selects de filtro y guarda los defaults Q-T del receptor.
model DteParty {
  id              String  @id @default(uuid())
  tenantId        String
  tenant          Tenant  @relation(fields: [tenantId], references: [id])
  /// Primer identificador con el que se vio a esta parte, tal cual el DTE
  /// (9 dígitos = DUI homologado, 14 = NIT). Desde el Addendum 11 fase 2 la
  /// ingesta NUNCA lo sobrescribe: la identidad la resuelve `canonicalKey` y un
  /// contribuyente puede ser referenciado por sus proveedores con los dos
  /// identificadores. Pisarlo haría chocar a la parte contra el
  /// `@@unique([tenantId, nit])`, que sigue vigente.
  nit             String
  /// Segundo identificador del mismo contribuyente, cuando sus proveedores lo
  /// referencian también con el NIT homologado al DUI (9 dígitos). Se completa
  /// solo si está vacío: nunca se reemplaza un identificador ya visto.
  dui             String?
  nrc             String?
  /// Clave canónica del contribuyente (Addendum 11, §2): NRC normalizado, o el
  /// NIT de 14 dígitos, o el DUI de 9. La calcula `resolveCanonicalKey()` y
  /// desde la fase 2 es la que RESUELVE la identidad en la ingesta y la que
  /// declara su unicidad. Anulable a propósito: una parte cuyo documento no trae
  /// NRC y cuyo identificador no mide 9 ni 14 dígitos (proveedor del exterior)
  /// no tiene clave, y eso se ve en la consulta del gate en vez de inventarse.
  canonicalKey    String?
  nombre          String
  nombreComercial String?
  codActividad    String?
  descActividad   String?
  departamento    String?
  municipio       String?
  distrito        String?
  complemento     String?
  telefono        String?
  correo          String?
  seenAsEmisor    Boolean @default(false)
  seenAsReceptor  Boolean @default(false)

  /// Defaults del Anexo 3 (columnas Q, R, S, T). Solo tienen sentido cuando la
  /// parte actúa como receptor. Precedencia: override del documento > este default.
  defaultTipoOperacion  Int?
  defaultClasificacion  Int?
  defaultSector         Int?
  defaultTipoCostoGasto Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emisorDocuments   PurchaseDocument[] @relation("DocEmisor")
  receptorDocuments PurchaseDocument[] @relation("DocReceptor")

  // Addendum 11 — fase 3: catálogo de actividades del contribuyente y mapeo
  // de proveedores. Las tres relaciones apuntan al mismo modelo, así que van
  // nombradas igual que DocEmisor/DocReceptor.
  activities                 PurchaseActivity[]        @relation("ActivityReceptor")
  supplierDefaultsAsReceptor SupplierActivityDefault[] @relation("SupplierDefaultReceptor")
  supplierDefaultsAsEmisor   SupplierActivityDefault[] @relation("SupplierDefaultEmisor")

  /// El `@@unique([tenantId, nit])` NO se reemplaza: convive con el de la clave
  /// canónica (desvío 1 del cierre de la fase 2 del Addendum 11). Tres razones.
  ///
  /// 1. Nunca causó el split del contribuyente. Lo causaba *resolver la
  ///    identidad* por `nit`, que es lo que se corrigió en el punto 2.
  /// 2. Es lo único que protege de duplicados a las partes con `canonicalKey`
  ///    NULA: en Postgres los nulos no colisionan entre sí, así que un UNIQUE
  ///    sobre la clave canónica no dice nada de ese caso.
  /// 3. No puede provocar un P2002 con la lógica actual de `findParty()`: `nit`
  ///    nunca se reescribe en un update y el `create` solo ocurre cuando ni la
  ///    clave ni el identificador encontraron fila.
  @@unique([tenantId, nit])
  /// Identidad del contribuyente (Addendum 11, fase 2, punto 1). Da además la
  /// búsqueda por clave que la ingesta hace dos veces por documento y el export
  /// una vez por archivo, así que reemplaza al índice no único que creó la
  /// migración del punto 2.
  @@unique([tenantId, canonicalKey])
  @@index([tenantId, seenAsEmisor])
  @@index([tenantId, seenAsReceptor])
  @@map("dte_parties")
}

/// Ledger de parseo: exactamente una fila por adjunto JSON procesado (ADR-10.1).
/// Los no-03 quedan como IGNORADO_TIPO; los duplicados apuntan al documento canónico.
model DteParseResult {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  attachmentId     String            @unique
  attachment       Attachment        @relation(fields: [attachmentId], references: [id])
  status           DteParseStatus
  tipoDte          String?
  version          Int?
  codigoGeneracion String?
  documentId       String? // PARSEADO y DUPLICADO apuntan al documento canónico
  document         PurchaseDocument? @relation(fields: [documentId], references: [id])
  errorDetail      String?
  /// Versión del parser que produjo esta fila. Permite re-parsear selectivamente
  /// cuando cambia la normalización (mode=failed del backfill).
  parserVersion    Int
  parsedAt         DateTime          @default(now())

  @@index([tenantId, status])
  @@index([documentId])
  @@map("dte_parse_results")
}

/// Comprobante de Crédito Fiscal parseado. Solo documentos válidos tipoDte "03".
model PurchaseDocument {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  attachmentId String     @unique // archivo fuente canónico
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  emailId      String
  accountId    String // desnormalizado para el filtro por cuenta

  // --- identificacion ---
  version          Int
  ambiente         String
  tipoDte          String
  numeroControl    String
  codigoGeneracion String // con guiones, tal cual se emitió; el export los quita
  tipoModelo       Int
  tipoOperacion    Int
  tipoContingencia Int?
  motivoContin     String?
  /// Fecha calendario sin zona (Hacienda emite YYYY-MM-DD). DATE no tiene zona,
  /// así que respeta la regla 7 de CLAUDE.md sin conversión.
  fecEmi           DateTime @db.Date
  horEmi           String
  tipoMoneda       String

  // --- partes: FK al catálogo + snapshot al momento de la emisión (ADR-10.2) ---
  emisorId                  String
  emisor                    DteParty @relation("DocEmisor", fields: [emisorId], references: [id])
  emisorNit                 String
  emisorNrc                 String?
  emisorNombre              String
  emisorNombreComercial     String?
  emisorCodActividad        String?
  emisorTipoEstablecimiento String? // solo v3
  emisorCodEstable          String?
  emisorCodPuntoVenta       String?
  receptorId                String
  receptor                  DteParty @relation("DocReceptor", fields: [receptorId], references: [id])
  receptorNit               String
  receptorNrc               String?
  receptorNombre            String
  receptorNombreComercial   String?
  /// Actividad económica del receptor al momento de la emisión (Addendum 11,
  /// §1.2). En `DteParty` el upsert la pisa con cada documento, así que sin este
  /// snapshot una empresa con varias actividades no puede segmentar sus compras.
  receptorCodActividad      String?
  receptorDescActividad     String?

  // --- resumen normalizado (v3 ivaRete1/ivaPerci1/reteRenta = v4 ivaRete/ivaPerci) ---
  totalNoSuj          Decimal @db.Decimal(18, 8)
  totalExenta         Decimal @db.Decimal(18, 8)
  totalGravada        Decimal @db.Decimal(18, 8)
  subTotalVentas      Decimal @db.Decimal(18, 8)
  descuNoSuj          Decimal @db.Decimal(18, 8)
  descuExenta         Decimal @db.Decimal(18, 8)
  descuGravada        Decimal @db.Decimal(18, 8)
  porcentajeDescuento Decimal @db.Decimal(18, 8)
  totalDescu          Decimal @db.Decimal(18, 8)
  subTotal            Decimal @db.Decimal(18, 8)
  ivaRetenido         Decimal @default(0) @db.Decimal(18, 8)
  ivaPercibido        Decimal @default(0) @db.Decimal(18, 8)
  retencionRenta      Decimal @default(0) @db.Decimal(18, 8)
  /// resumen.tributos[codigo = "20"].valor - columna N del Anexo 3.
  ivaCreditoFiscal    Decimal @default(0) @db.Decimal(18, 8)
  montoTotalOperacion Decimal @db.Decimal(18, 8)
  totalNoGravado      Decimal @db.Decimal(18, 8)
  totalPagar          Decimal @db.Decimal(18, 8)
  saldoFavor          Decimal @db.Decimal(18, 8)
  totalLetras         String
  condicionOperacion  Int
  numPagoElectronico  String?
  observaciones       String?

  // --- secciones sin normalizar + copia íntegra (ADR-10.8) ---
  selloRecibido        String?
  documentoRelacionado Json?
  otrosDocumentos      Json?
  ventaTercero         Json?
  extension            Json?
  apendice             Json?
  rawJson              Json

  // --- overrides del Anexo 3 (Q, R, S, T): null = usar default del receptor ---
  anexoTipoOperacion  Int?
  anexoClasificacion  Int?
  anexoSector         Int?
  anexoTipoCostoGasto Int?
  anexoNota           String?
  classifiedById      String?
  classifiedAt        DateTime?

  /// Override de la actividad de la compra (Addendum 11, fase 3, §7.4).
  ///
  /// `null` = usar el default por (proveedor, receptor); si tampoco hay, la
  /// compra queda sin actividad. Es la primera etapa de la resolución en dos
  /// pasos: la actividad resuelta es la que después elige los defaults Q–T.
  ///
  /// Columnas PROPIAS y no reutilizadas: `activityAssignedById` /
  /// `activityAssignedAt` no son `classifiedById` / `classifiedAt`. Son dos
  /// decisiones contables distintas, tomadas en momentos distintos —asignar la
  /// unidad de negocio de una compra no es clasificar sus columnas Q–T—, y
  /// compartir las columnas de auditoría haría que la segunda pisara el
  /// registro de quién tomó la primera.
  ///
  /// `activityAssignedById` queda sin FK a `users`, igual que `classifiedById`:
  /// es el registro de quién decidió, y borrar un usuario no puede borrar ni
  /// bloquear la traza de una decisión contable ya tomada.
  ///
  /// `onDelete: Restrict` y NO el `SET NULL` que Prisma pone por defecto en una
  /// relación opcional. Dos razones, y las dos apuntan al mismo lugar:
  ///
  ///   1. Es lo que ya promete la aplicación. `PurchaseActivityService.remove()`
  ///      rechaza con 422 el borrado de una actividad referenciada por un
  ///      documento O por el mapeo de un proveedor. Con `SET NULL` esa garantía
  ///      viviría solo en el servicio para un lado de la pareja, mientras que
  ///      `supplier_activity_defaults.activityId` sí tiene respaldo en la base:
  ///      la asimetría dejaba un solo camino sin red.
  ///   2. `SET NULL` corrompe la auditoría. Borra `activityId` pero conserva
  ///      `activityAssignedById` / `activityAssignedAt`, o sea la traza de una
  ///      decisión sobre una actividad que ya no se puede resolver: exactamente
  ///      lo contrario de lo que dice el comentario de esas dos columnas.
  ///
  /// La salida para retirar una actividad en uso es desactivarla (`active`),
  /// que es la operación que el addendum define para ese caso.
  activityId           String?
  activity             PurchaseActivity? @relation("DocActivity", fields: [activityId], references: [id], onDelete: Restrict)
  activityAssignedById String?
  activityAssignedAt   DateTime?

  parserVersion Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items        PurchaseDocumentItem[]
  taxes        PurchaseDocumentTax[]
  payments     PurchaseDocumentPayment[]
  parseResults DteParseResult[]

  // Idempotencia del libro entre buzones del mismo tenant. No se elimina ni se
  // relaja: es el equivalente de @@unique([accountId, messageId]) para el DTE.
  @@unique([tenantId, codigoGeneracion])
  @@index([tenantId, fecEmi])
  @@index([tenantId, receptorId, fecEmi])
  @@index([tenantId, emisorId, fecEmi])
  @@index([tenantId, accountId, fecEmi])
  @@index([tenantId, numeroControl])
  /// Soporta el lado "override" del filtro por actividad y la guarda de
  /// referencias que impide borrar una actividad ya usada.
  @@index([tenantId, activityId])
  @@map("purchase_documents")
}

/// cuerpoDocumento[]
model PurchaseDocumentItem {
  id              String           @id @default(uuid())
  tenantId        String
  documentId      String
  document        PurchaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  numItem         Int
  tipoItem        Int
  numeroDocumento String?
  cantidad        Decimal          @db.Decimal(18, 8)
  codigo          String?
  codTributo      String?
  uniMedida       Int
  descripcion     String
  precioUni       Decimal          @db.Decimal(18, 8)
  montoDescu      Decimal          @db.Decimal(18, 8)
  ventaNoSuj      Decimal          @db.Decimal(18, 8)
  ventaExenta     Decimal          @db.Decimal(18, 8)
  ventaGravada    Decimal          @db.Decimal(18, 8)
  tributos        String[] // ["20"] o []
  psv             Decimal          @db.Decimal(18, 8)
  noGravado       Decimal          @db.Decimal(18, 8)

  @@unique([documentId, numItem])
  @@index([tenantId])
  @@map("purchase_document_items")
}

/// resumen.tributos[]
model PurchaseDocumentTax {
  id          String           @id @default(uuid())
  tenantId    String
  documentId  String
  document    PurchaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  codigo      String
  descripcion String
  valor       Decimal          @db.Decimal(18, 8)

  @@unique([documentId, codigo])
  @@index([tenantId])
  @@map("purchase_document_taxes")
}

/// resumen.pagos[]
model PurchaseDocumentPayment {
  id         String           @id @default(uuid())
  tenantId   String
  documentId String
  document   PurchaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position   Int
  codigo     String
  montoPago  Decimal          @db.Decimal(18, 8)
  referencia String?
  plazo      String?
  periodo    Int?

  @@unique([documentId, position])
  @@index([tenantId])
  @@map("purchase_document_payments")
}

// =============================================================
// Addendum 11 — fase 3: segmentación por actividad
//
// La actividad de una compra NO es el `receptorCodActividad` que trae el DTE:
// ese código lo declara el proveedor y se conserva solo como dato informativo
// para prellenar el mapeo (§7.4). La actividad efectiva se resuelve en dos
// etapas, con la MISMA precedencia que las columnas Q–T:
//
//   actividad = override del documento > default por (proveedor, receptor) > sin clasificar
//   Q–T       = override del documento > default de la actividad resuelta
//               > default del receptor > sin clasificar
//
// Las dos tablas llevan tenantId y RLS FORCE + policy tenant_isolation,
// escritas a mano en la migración (Prisma no las genera).
// =============================================================

/// Catálogo de actividades económicas de UN contribuyente (Addendum 11, fase 3).
///
/// El contador ve "Restaurante"; el sistema conserva el CIIU para prellenar el
/// mapeo y para contrastar contra lo que declaran los proveedores.
model PurchaseActivity {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// El catálogo pertenece a un solo contribuyente. Un catálogo global al
  /// tenant mezclaría las unidades de negocio de un receptor con las de otro,
  /// que es el mismo error de forma que un export con dos receptores (regla 31
  /// de CLAUDE.md).
  receptorId String
  receptor   DteParty @relation("ActivityReceptor", fields: [receptorId], references: [id])

  /// Identidad de la actividad: el nombre que le puso el contribuyente. Es lo
  /// que declara el `@@unique` de más abajo.
  nombre String

  /// Código CIIU, deliberadamente NO único y anulable.
  ///
  /// NO único: dos locales del mismo rubro son dos unidades de negocio
  /// distintas con el mismo código CIIU. El código es una pista para prellenar
  /// el mapeo, no una identidad; el que identifica es el nombre.
  ///
  /// Anulable: el contador puede crear una actividad que no corresponde a
  /// ningún código visto en los DTE, y forzarlo a inventar un código sería
  /// exactamente lo que prohíbe la regla 30 de CLAUDE.md para las columnas Q–T.
  codActividad String?

  /// Retiro de una actividad sin romper lo que la referencia. Ver
  /// `PurchaseActivityService.remove()`: un DELETE deja el mapeo de proveedores
  /// apuntando al vacío, así que una actividad referenciada se desactiva.
  ///
  /// Se llama `active` y no `activo` por la regla 23 de CLAUDE.md: los
  /// identificadores van en inglés. Es además el nombre que ya usan `Tenant` y
  /// `MailProvider` para este mismo concepto. Los términos del dominio fiscal
  /// (`nombre`, `codActividad`, `receptorId`) sí conservan el español porque son
  /// el vocabulario del DTE, no una decisión de estilo.
  active Boolean @default(true)

  /// Defaults del Anexo 3 (columnas Q, R, S, T) de esta actividad. Se
  /// interponen entre el override del documento y el default del receptor.
  /// Su consumo desde `resolveClassification()` es una rebanada posterior.
  defaultTipoOperacion  Int?
  defaultClasificacion  Int?
  defaultSector         Int?
  defaultTipoCostoGasto Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierDefaults SupplierActivityDefault[]
  documents        PurchaseDocument[]        @relation("DocActivity")

  @@unique([tenantId, receptorId, nombre])
  @@index([tenantId])
  /// Listado del catálogo de un receptor, con y sin las desactivadas.
  @@index([tenantId, receptorId, active])
  @@map("purchase_activities")
}

/// Actividad por defecto de un proveedor para UN receptor (Addendum 11, §7.4).
///
/// Son las ~30 filas que hacen viable la carga inicial: cubren el histórico
/// completo y todo lo que venga de esos mismos proveedores. El override del
/// documento corrige el resto.
///
/// **Es una relación ternaria y por eso NO puede ser un campo del `DteParty`
/// del emisor.** El mismo distribuidor le vende a varios contribuyentes del
/// mismo buzón y a cada uno le sirve una unidad de negocio distinta. Un campo
/// colgado del emisor sería global al tenant y aplicaría el criterio de un
/// contribuyente a las compras de otro: el mismo error de forma que un export
/// mezclando receptores (regla 31 de CLAUDE.md), con la misma consecuencia.
model SupplierActivityDefault {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  receptorId String
  receptor   DteParty @relation("SupplierDefaultReceptor", fields: [receptorId], references: [id])
  emisorId   String
  emisor     DteParty @relation("SupplierDefaultEmisor", fields: [emisorId], references: [id])

  activityId String
  activity   PurchaseActivity @relation(fields: [activityId], references: [id])

  /// Quién definió el mapeo y cuándo, con la misma forma que
  /// `classifiedById` / `classifiedAt` de `PurchaseDocument`: es una decisión
  /// contable y tiene que quedar la traza. Sin FK a `users`, por lo mismo que
  /// aquellas.
  assignedById String?
  assignedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un proveedor tiene un solo default por receptor. Es lo que hace idempotente
  /// la aplicación de la siembra.
  @@unique([tenantId, receptorId, emisorId])
  @@index([tenantId])
  /// Resolución de la actividad efectiva: dado un receptor, el mapeo de sus
  /// proveedores. Con `activityId` al final sirve además para la guarda de
  /// referencias antes de borrar una actividad.
  @@index([tenantId, receptorId, activityId])
  @@map("supplier_activity_defaults")
}
