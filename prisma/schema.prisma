generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVA
  INACTIVA
  ERROR_AUTH
}

enum TenantStatus {
  ACTIVO
  SUSPENDIDO
}

enum Role {
  SUPERADMIN
  ADMIN
  MIEMBRO
}

enum EmailStatus {
  PROCESADO
  SIN_ADJUNTOS
  ERROR
}

enum AttachmentType {
  JSON
  PDF
}

enum SyncStatus {
  EJECUTANDO
  COMPLETADO
  COMPLETADO_CON_ERRORES
  ERROR
}

enum DomainMatchKind {
  DOMAIN // dominio del correo: gmail.com
  MX_SUFFIX // sufijo del registro MX: google.com
}

model Tenant {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique // [a-z0-9-], inmutable tras la creación
  status          TenantStatus @default(ACTIVO)
  maxAccounts     Int          @default(3)
  maxStorageBytes BigInt       @default(5368709120) // 5 GB
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users       User[]
  apiKeys     TenantApiKey[]
  accounts    EmailAccount[]
  emails      ProcessedEmail[]
  attachments Attachment[]
  syncLogs    SyncLog[]

  @@map("tenants")
}

model User {
  id                      String    @id @default(uuid())
  tenantId                String? // null solo para SUPERADMIN
  tenant                  Tenant?   @relation(fields: [tenantId], references: [id])
  email                   String    @unique
  name                    String
  passwordHash            String // argon2id
  role                    Role      @default(MIEMBRO)
  active                  Boolean   @default(true)
  lastLoginAt             DateTime?
  // Estado mínimo necesario para rotación de refresh token y logout: hash del jti
  // del refresh token vigente. Sesión única por usuario a propósito (MVP); un login
  // o refresh nuevo sobrescribe este valor e invalida cualquier refresh token previo.
  currentRefreshTokenHash String?
  createdAt               DateTime  @default(now())

  @@index([tenantId])
  @@map("users")
}

model TenantApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String // "CLI oficina", "n8n"
  keyHash    String    @unique // sha256 de la key; la key en claro solo se muestra al crear
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@map("tenant_api_keys")
}

/// Catálogo maestro global de servicios de correo (Addendum 09). Sin tenantId:
/// es público a todos los tenants y solo SUPERADMIN lo escribe. Deliberadamente
/// SIN RLS — ver el comentario de la migración mail_providers.
model MailProvider {
  id             String  @id @default(uuid())
  key            String  @unique // "gmail", "microsoft365"
  name           String // "Gmail / Google Workspace"
  imapHost       String
  imapPort       Int     @default(993)
  imapSecure     Boolean @default(true)
  defaultMailbox String  @default("INBOX")
  /// Dominio obvio (gmail.com, outlook.com): advertir si el usuario cambia el
  /// perfil detectado automáticamente por otro (ADR-09.1).
  strict         Boolean @default(false)
  /// Requisitos de autenticación en lenguaje del usuario ("necesitás una
  /// contraseña de aplicación"). Es lo que evita la mayoría de los tickets.
  notes          String?
  helpUrl        String?
  /// false = oculto del desplegable de alta. NO desvincula cuentas existentes:
  /// es el mecanismo de retiro de un perfil, en vez del DELETE (ADR-09.1).
  active         Boolean @default(true)
  sortOrder      Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains  MailProviderDomain[]
  accounts EmailAccount[]

  @@map("mail_providers")
}

/// Dominios que resuelven a un perfil, por coincidencia exacta del dominio del
/// correo (DOMAIN) o por sufijo del registro MX (MX_SUFFIX, ADR-09.3).
model MailProviderDomain {
  id         String          @id @default(uuid())
  providerId String
  provider   MailProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  domain     String
  kind       DomainMatchKind @default(DOMAIN)
  createdAt  DateTime        @default(now())

  // La unicidad es por (kind, domain), no por domain solo: "outlook.com" existe
  // como dominio de correo personal Y como sufijo MX de Microsoft 365.
  @@unique([kind, domain])
  @@index([providerId])
  @@map("mail_provider_domains")
}

model EmailAccount {
  id         String @id @default(uuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  alias      String // "Compras Casa Matriz"
  email      String // compras@ltsoft.us
  folderName String // compras_ltsoft_us (normalizado)

  /// ADR-09.1/09.2 — referencia viva: con providerId, el endpoint efectivo sale
  /// del perfil en cada sync (un cambio del SUPERADMIN aplica en la siguiente
  /// ronda). Con providerId NULL, mandan las tres columnas imap* de abajo:
  /// ese es el camino "servidor personalizado". Resolución en un solo lugar:
  /// src/sync/imap/resolve-imap-endpoint.ts
  providerId String?
  provider   MailProvider? @relation(fields: [providerId], references: [id], onDelete: Restrict)

  imapHost     String
  imapPort     Int           @default(993)
  imapSecure   Boolean       @default(true)
  imapUser     String
  imapPassEnc  String // AES-256-GCM (iv:tag:cipher, base64)
  mailbox      String        @default("INBOX")
  syncInterval Int           @default(300) // segundos
  syncFromDate DateTime      @default(now())
  lastUid      Int           @default(0)
  uidValidity  BigInt? // detección de reset del buzón
  lastSyncAt   DateTime?
  lastError    String?
  status       AccountStatus @default(ACTIVA)
  deletedAt    DateTime? // soft delete
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  emails   ProcessedEmail[]
  syncLogs SyncLog[]

  @@unique([tenantId, email])
  @@unique([tenantId, folderName])
  @@index([tenantId])
  @@index([providerId])
  @@map("email_accounts")
}

model ProcessedEmail {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  accountId       String
  account         EmailAccount @relation(fields: [accountId], references: [id])
  messageId       String // header Message-ID
  uid             Int // UID IMAP
  subject         String       @default("")
  senderName      String       @default("")
  senderEmail     String
  recipients      String[] // direcciones To
  receivedAt      DateTime // header Date (UTC)
  processedAt     DateTime     @default(now())
  monthFolder     String // "2026-08" (TZ El Salvador)
  attachmentCount Int          @default(0)
  status          EmailStatus
  errorDetail     String?

  attachments Attachment[]

  @@unique([accountId, messageId]) // idempotencia — accountId ya es único global, no se toca
  @@index([accountId, receivedAt])
  @@index([tenantId, receivedAt])
  @@index([senderEmail])
  @@index([status])
  @@map("processed_emails")
}

model Attachment {
  id           String         @id @default(uuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  emailId      String
  email        ProcessedEmail @relation(fields: [emailId], references: [id])
  originalName String
  storedName   String
  relativePath String // compras_ltsoft_us/2026-08/json/x.json
  fileType     AttachmentType
  mimeType     String
  sizeBytes    Int
  sha256       String
  createdAt    DateTime       @default(now())

  @@index([emailId])
  @@index([sha256])
  @@index([tenantId, createdAt, id])
  @@map("attachments")
}

model SyncLog {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  accountId       String
  account         EmailAccount @relation(fields: [accountId], references: [id])
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  emailsFound     Int          @default(0)
  emailsProcessed Int          @default(0)
  emailsSkipped   Int          @default(0) // duplicados
  filesDownloaded Int          @default(0)
  status          SyncStatus   @default(EJECUTANDO)
  errorDetail     String?
  trigger         String       @default("scheduler") // scheduler | manual

  @@index([accountId, startedAt])
  @@index([tenantId, startedAt])
  @@map("sync_logs")
}
