{
  /* Proyecto de tests: mismas opciones estrictas que la app, pero con los
     globals de Vitest disponibles. Se mantiene separado de tsconfig.app.json
     para que el código de producción no pueda usar `describe`/`vi` sin que el
     compilador lo marque. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src/test", "src/**/*.spec.ts", "src/**/*.spec.tsx"],
  "exclude": []
}
